# ─── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# Get from: Supabase Dashboard → Settings → Database → Connection string (URI)
# Use the "Transaction" pooler URL for serverless (port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-random-secret-min-32-chars

# ─── Manus OAuth (if using Manus login) ───────────────────────────────────────
VITE_APP_ID=your-manus-app-id
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://manus.im
OWNER_OPEN_ID=your-owner-open-id
OWNER_NAME=your-name

# ─── OpenAI ───────────────────────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ─── Lemon Squeezy ────────────────────────────────────────────────────────────
# Get from: https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=your-ls-api-key
# Get from: Lemon Squeezy Dashboard → Stores
LEMONSQUEEZY_STORE_ID=12345
# Get from: Lemon Squeezy Dashboard → Products → [Product] → Variants
LEMONSQUEEZY_VARIANT_ID=67890
# Set your own signing secret when creating webhook
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-signing-secret

# ─── Manus Built-in APIs (optional, only if using Manus platform) ─────────────
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=

# ─── Stripe (optional, not used in current version) ───────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# VITE_STRIPE_PUBLISHABLE_KEY=
